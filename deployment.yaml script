======================================================
# deploys your application onto the pod
======================================================

apiversion: apps/v1
kind: Deployment 
metadata:
  name: dev-nest-eks-deployment       #Update as needed
  namespace: dev-nest-eks-namespace    # Update as needed, must match Service metadata.namespace
  labels:
    app: nest-app   #Must match Service selector.app
spec:
  replicas: 1
  selector:
    matchLabels:
      app: nest-app    #Must match Service selector.app
 template:
   metadata:
     labels:
       app: nest-app    #Must match Service selector.App 
    spec: 
      serviceAccountName: dev-nest-eks-service-account
      volumes:
      - name: secrets-store-inline
        csi:
          driver: secrets-store.csi.k8s.io
          readonly: true
          volumeAttributes:
            secretProviderClass: dev-nest-eks-secret-provider-class     #Update as needed, must match SecretProviderClass metadata.name 
      containers:
      - name: dev-nest-eks-container     # Update as needed
        image: EKS-URI.amazonaws.com/nest:latest
        imagePullPolicy: Always
        ports:
        - containerPort: 80   #Update as needed, must match Service ports.targetPort
        volumeMounts:
        - name: secrets-store-inline
          mountPath: "/mnt/secrets-store"
          readonly: true
